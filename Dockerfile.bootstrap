# bootstrap 镜像: 轻量(仅 bash+curl), 负责"抓源 -> 合并 -> 生成 config.yaml"
# 内核本体用官方 metacubex/mihomo 镜像, 这里不下载任何内核, 构建不依赖 GitHub
FROM alpine:3.20

RUN apk add --no-cache bash curl ca-certificates

COPY merge-sources.sh /usr/local/bin/merge-sources.sh
COPY config.base.yaml /app/config.base.yaml
COPY bootstrap.sh /usr/local/bin/bootstrap.sh

# 节点源列表。运行期会被 compose 用 ./config 覆盖挂载；
# 这里的 COPY 只是「没挂载时也能跑」的兜底。
COPY config/sources.txt /app/config/sources.txt

RUN chmod +x /usr/local/bin/merge-sources.sh /usr/local/bin/bootstrap.sh

WORKDIR /work
CMD ["/usr/local/bin/bootstrap.sh"]
