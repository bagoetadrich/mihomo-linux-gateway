# ============================================================
# .env 示例 —— 复制成 .env 后按需修改
#
# 正常情况下你不需要手动做这件事：./up.sh 首次运行会自动生成 .env，
# 并写入一个随机面板密码。这个文件只是给你「想手动调」时参考。
#
# .env 已在 .gitignore 中，不会被提交。
# ============================================================

# 管理面板登录密码（必填；留空则容器会自己生成一个并打印到日志）
PANEL_PASSWORD=换成你自己的密码

# 面板监听地址。
#   0.0.0.0        = 局域网 + ZeroTier 都能访问（默认）
#   <ZeroTier IP>  = 只有 ZeroTier 网内能访问（更安全）
#   127.0.0.1      = 只有服务器本机能访问（要自己开 SSH 隧道）
PANEL_LISTEN=0.0.0.0

# 面板端口
PANEL_PORT=9091

# mihomo 管理 API 的 secret。
# 仅当你在 config.base.yaml 里给 external-controller 配了 secret 时才需要填，
# 且必须与那里保持一致。默认 config.base.yaml 绑定回环且无 secret，此处留空。
# MIHOMO_SECRET=

# ---------------- 邮件告警（可选） ----------------
# 也可以不写在这里，而是登录面板后在「运维 → 邮件告警」里配置；
# 面板里保存的配置会存在 data/panel/alerts.json（同样已 gitignore）。
# 这里填了的话，面板首次启动会作为初始值读入。
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASS=你的授权码
# SMTP_FROM=you@example.com
# SMTP_FROM_NAME=网关告警
# ALERT_TO=接收告警的邮箱
# ALERT_ENABLED=false

# ---------------- 定时刷新节点池（可选） ----------------
# 面板内置的定时刷新，默认「开启、每 6 小时一次」，可在面板「运维」页直接改。
# 这里的值只在**首次启动**（还没有 data/panel/refresh.json 时）作为初值。
# 想彻底关掉自动抓源就设 REFRESH_ENABLED=false。
# REFRESH_ENABLED=true
# REFRESH_HOURS=6

# ---------------- 设备页的网络标签（可选） ----------------
# 「设备与连接」页里，来源 IP 会先按这些前缀显示成友好名字。
# 不设也完全没问题，会退化成「内网 x.x.x.x」。
# 想给单个 IP 起确切名字，改 config/devices.json（格式见 README）。
# ZT_NETS=10.147.0.
# VPN_NETS=10.10.0.
